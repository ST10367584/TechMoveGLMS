@model Contract
@{
    ViewData["Title"] = $"Contract #{Model.Id}";
    var canAddRequest = Model.Status != ContractStatus.Expired && Model.Status != ContractStatus.OnHold;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-file-earmark-text text-primary"></i> Contract #@Model.Id</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
        @if (canAddRequest)
        {
            <a asp-controller="ServiceRequests" asp-action="Create" asp-route-contractId="@Model.Id" class="btn btn-success"><i class="bi bi-plus-circle"></i> Add Service Request</a>
        }
        else
        {

            <button class="btn btn-success" disabled><i class="bi bi-plus-circle"></i> Add Request (Contract @Model.Status)</button>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>
@if (!canAddRequest)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> This contract is <strong>@Model.Status</strong>. Service requests cannot be created.</div>
}
<div class="row mb-4">
    <div class="col-md-5"><div class="card-modern p-3"><dl class="row mb-0"><dt class="col-sm-5">Client</dt><dd class="col-sm-7"><a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId">@Model.Client?.Name</a></dd><dt class="col-sm-5">Service Level</dt><dd class="col-sm-7">@Model.ServiceLevel</dd><dt class="col-sm-5">Start Date</dt><dd class="col-sm-7">@Model.StartDate.ToString("dd MMM yyyy")</dd><dt class="col-sm-5">End Date</dt><dd class="col-sm-7">@Model.EndDate.ToString("dd MMM yyyy")</dd><dt class="col-sm-5">Status</dt><dd class="col-sm-7"><span class="badge @(Model.Status == ContractStatus.Active ? "bg-success" : Model.Status == ContractStatus.Expired ? "bg-danger" : "bg-secondary")">@Model.Status</span></dd></dl></div></div>
    <div class="col-md-4"><div class="card-modern p-3"><strong><i class="bi bi-file-earmark-pdf"></i> Signed Agreement</strong><br />@if (!string.IsNullOrEmpty(Model.SignedAgreementPath)){
    <a asp-action="DownloadAgreement" asp-route-id="@Model.Id" class="btn btn-outline-danger mt-2"><i class="bi bi-download"></i> Download PDF</a>
        }else
    {

        <p class="text-muted">No agreement uploaded.</p>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Upload</a>
}</ div ></ div >
</div>
<div class="card-modern">
    <div class="card-header"><strong><i class="bi bi-list-check"></i> Service Requests (@Model.ServiceRequests.Count)</strong></div><div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Description</th><th>Cost USD</th><th>Cost ZAR</th><th>Rate</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var sr in Model.ServiceRequests.OrderByDescending(s => s.CreatedAt))
                {
                    <tr><td>@sr.Id</td><td>@sr.Description</td><td>$@sr.CostUSD.ToString("N2")</td><td class="fw-semibold text-success">R @sr.CostZAR.ToString("N2")</td><td><small>@sr.ExchangeRateUsed.ToString("N4")</small></td><td><span class="badge bg-@(sr.Status == ServiceRequestStatus.Pending ? "warning" : sr.Status == ServiceRequestStatus.Completed ? "success" : "secondary")">@sr.Status</span></td><td><small>@sr.CreatedAt.ToString("dd MMM yyyy")</small></td><td><a asp-controller="ServiceRequests" asp-action="Edit" asp-route-id="@sr.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a> <a asp-controller="ServiceRequests" asp-action="Delete" asp-route-id="@sr.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a></td></tr>
                }
                @if (!Model.ServiceRequests.Any())
                {
                    <tr><td colspan="8" class="text-center py-4">No service requests yet.@if(canAddRequest){
                    <a asp-controller="ServiceRequests" asp-action="Create" asp-route-contractId="@Model.Id"> Create one</a>
                }
</td></tr>
                                }
            </tbody>
        </table>
    </div>
</div>