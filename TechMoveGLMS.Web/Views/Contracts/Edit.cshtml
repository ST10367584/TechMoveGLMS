@model ContractCreateViewModel
@{
    ViewData["Title"] = $"Edit Contract #{Model.Contract.Id}";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h2><i class="bi bi-pencil-square text-warning"></i> Edit Contract #@Model.Contract.Id</h2></div>
    <a asp-action="Details" asp-route-id="@Model.Contract.Id" class="btn btn-outline-secondary rounded-pill">Back</a>
</div>
<div class="card-modern p-4">
    <form asp-action="Edit" asp-route-id="@Model.Contract.Id" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Contract.Id" /><input type="hidden" asp-for="Contract.CreatedAt" /><input type="hidden" asp-for="Contract.SignedAgreementPath" /><input type="hidden" asp-for="Contract.SignedAgreementFileName" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3"><label>Client</label><select asp-for="Contract.ClientId" class="form-select" asp-items="@(new SelectList(Model.Clients, "Id", "Name", Model.Contract.ClientId))"></select></div>
        <div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="Contract.StartDate"></label><input asp-for="Contract.StartDate" class="form-control" type="date" /></div><div class="col-md-6"><label asp-for="Contract.EndDate"></label><input asp-for="Contract.EndDate" class="form-control" type="date" /></div></div>
        <div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="Contract.Status"></label><select asp-for="Contract.Status" class="form-select" asp-items="Html.GetEnumSelectList<ContractStatus>()"></select></div><div class="col-md-6"><label asp-for="Contract.ServiceLevel"></label><select asp-for="Contract.ServiceLevel" class="form-select" asp-items="Html.GetEnumSelectList<ServiceLevel>()"></select></div></div>
        <div class="mb-3"><label asp-for="Contract.Notes"></label><textarea asp-for="Contract.Notes" class="form-control" rows="2"></textarea></div>
        <div class="mb-3"><label>Replace Signed Agreement (optional)</label><input asp-for="SignedAgreement" type="file" class="form-control" accept=".pdf" /><div class="form-text">Current: @(Model.Contract.SignedAgreementFileName ?? "None")</div></div>
        <button type="submit" class="btn btn-warning"><i class="bi bi-floppy"></i> Update</button>
        <a asp-action="Details" asp-route-id="@Model.Contract.Id" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}