@model ContractSearchViewModel
@{
    ViewData["Title"] = "Contracts";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-file-earmark-text text-primary"></i> Contracts</h2>
    <a asp-action="Create" class="btn btn-gradient"><i class="bi bi-plus-circle"></i> New Contract</a>
</div>
<div class="card-modern p-4 mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-3"><label class="form-label small">Keyword</label><input type="text" name="SearchTerm" class="form-control" placeholder="Client or notes" value="@Model.SearchTerm" /></div>
        <div class="col-md-2"><label class="form-label small">Status</label><select name="StatusFilter" class="form-select"><option value="">All</option>@foreach (var s in Enum.GetValues<ContractStatus>()){
        <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                }
</select></div>
        <div class="col-md-2"><label class="form-label small">Client</label><select name="ClientFilter" class="form-select"><option value="">All</option>@foreach (var c in Model.AllClients){
        <option value="@c.Id" selected="@(Model.ClientFilter == c.Id)">@c.Name</option>
                }
</select></div>
        <div class="col-md-2"><label class="form-label small">Start Date From</label><input type="date" name="StartDateFrom" class="form-control" value="@Model.StartDateFrom?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-2"><label class="form-label small">Start Date To</label><input type="date" name="StartDateTo" class="form-control" value="@Model.StartDateTo?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-1 d-flex align-items-end"><button class="btn btn-gradient w-100"><i class="bi bi-search"></i></button><a asp-action="Index" class="btn btn-outline-secondary ms-1"><i class="bi bi-x"></i></a></div>
    </form>
</div>
<div class="card-modern">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>#</th><th>Client</th><th>Service Level</th><th>Start Date</th><th>End Date</th><th>Status</th><th>Requests</th><th>Agreement</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Results)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@c.Client?.Name</td>
                        <td>@c.ServiceLevel</td>
                        <td>@c.StartDate.ToString("dd MMM yyyy")</td>
                        <td>@c.EndDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @(c.Status == ContractStatus.Active ? "bg-success" : c.Status == ContractStatus.Expired ? "bg-danger" : "bg-secondary")">@c.Status</span></td>
                        <td>@c.ServiceRequests.Count</td>
                        <td>@if (!string.IsNullOrEmpty(c.SignedAgreementPath)){
                        <a asp-action="DownloadAgreement" asp-route-id="@c.Id" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                    }else
                    {

                        <span class="text-muted">None</span>
                    }
</td>
                    <td><a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a> <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a> <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a></td>
                </tr>
                                }
                @if (!Model.Results.Any())
                {
                    <tr><td colspan="9" class="text-center py-4">No contracts match your filters.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>