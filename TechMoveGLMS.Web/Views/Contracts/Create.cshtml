@model ContractCreateViewModel
@{
    ViewData["Title"] = "New Contract";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="display-5 fw-bold" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); -webkit-background-clip: text; background-clip: text; color: transparent;"><i class="bi bi-file-earmark-plus"></i> New Contract</h1></div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="card-modern p-4">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3"><label asp-for="Contract.ClientId" class="form-label fw-semibold">Client</label><select asp-for="Contract.ClientId" class="form-select" asp-items="@(new SelectList(Model.Clients, "Id", "Name"))"><option value="">-- Select --</option></select><span asp-validation-for="Contract.ClientId" class="text-danger"></span></div>
        <div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="Contract.StartDate" class="form-label"></label><input asp-for="Contract.StartDate" class="form-control" type="date" /></div><div class="col-md-6"><label asp-for="Contract.EndDate" class="form-label"></label><input asp-for="Contract.EndDate" class="form-control" type="date" /></div></div>
        <div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="Contract.Status" class="form-label"></label><select asp-for="Contract.Status" class="form-select" asp-items="Html.GetEnumSelectList<ContractStatus>()"></select></div><div class="col-md-6"><label asp-for="Contract.ServiceLevel" class="form-label"></label><select asp-for="Contract.ServiceLevel" class="form-select" asp-items="Html.GetEnumSelectList<ServiceLevel>()"></select></div></div>
        <div class="mb-3"><label asp-for="Contract.Notes" class="form-label"></label><textarea asp-for="Contract.Notes" class="form-control" rows="2"></textarea></div>
        <div class="mb-3"><label class="form-label fw-semibold"><i class="bi bi-file-earmark-pdf text-danger"></i> Signed Agreement (PDF)</label><input asp-for="SignedAgreement" type="file" class="form-control" accept=".pdf" /><div class="form-text">Only PDF, max 10 MB.</div></div>
        <button type="submit" class="btn btn-gradient"><i class="bi bi-floppy"></i> Create Contract</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}