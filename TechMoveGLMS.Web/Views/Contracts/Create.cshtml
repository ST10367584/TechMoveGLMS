@model ContractCreateViewModel
@{
    ViewData["Title"] = "New Contract";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-5 fw-bold mb-1" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">
            <i class="bi bi-file-earmark-plus-fill"></i> New Contract
        </h1>
        <p class="text-muted">Create a new service agreement and upload the signed contract</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left"></i> Back to Contracts
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Main Form Column -->
    <div class="col-lg-8">
        <div class="card-modern">
            <div class="card-header bg-transparent border-0 p-4 pb-0">
                <div class="d-flex align-items-center">
                    <div class="avatar-lg me-3" style="background: linear-gradient(135deg, rgba(79, 172, 254, 0.1) 0%, rgba(0, 242, 254, 0.1) 100%);">
                        <i class="bi bi-file-earmark-text fs-3" style="color: #4facfe;"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Contract Details</h5>
                        <small class="text-muted">Enter all contract information and upload the signed agreement</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="contractForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-modern alert-danger" role="alert"></div>

                    <!-- Client Selection -->
                    <div class="mb-4">
                        <label asp-for="Contract.ClientId" class="form-label fw-semibold mb-2">
                            <i class="bi bi-building text-primary"></i> Client <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0">
                                <i class="bi bi-people"></i>
                            </span>
                            <select asp-for="Contract.ClientId" class="form-select border-start-0 ps-0 client-select"
                                    asp-items="@(new SelectList(Model.Clients, "Id", "Name"))">
                                <option value="">-- Select a client --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Contract.ClientId" class="text-danger small mt-1 d-block"></span>
                        @if (!Model.Clients.Any())
                        {
                            <div class="alert alert-warning mt-2 py-2">
                                <i class="bi bi-exclamation-triangle"></i>
                                No clients available. <a asp-controller="Clients" asp-action="Create">Add a client first</a>.
                            </div>
                        }
                    </div>

                    <!-- Contract Dates Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Contract.StartDate" class="form-label fw-semibold mb-2">
                                <i class="bi bi-calendar-event text-success"></i> Start Date <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0">
                                    <i class="bi bi-calendar"></i>
                                </span>
                                <input asp-for="Contract.StartDate" class="form-control border-start-0 ps-0 date-picker"
                                       type="date" />
                            </div>
                            <span asp-validation-for="Contract.StartDate" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Contract.EndDate" class="form-label fw-semibold mb-2">
                                <i class="bi bi-calendar-x text-danger"></i> End Date <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0">
                                    <i class="bi bi-calendar"></i>
                                </span>
                                <input asp-for="Contract.EndDate" class="form-control border-start-0 ps-0 date-picker"
                                       type="date" />
                            </div>
                            <span asp-validation-for="Contract.EndDate" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Contract Type Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Contract.Status" class="form-label fw-semibold mb-2">
                                <i class="bi bi-tag text-info"></i> Contract Status
                            </label>
                            <select asp-for="Contract.Status" class="form-select status-select">
                                @foreach (var status in Enum.GetValues(typeof(ContractStatus)))
                                {
                                    var statusValue = (ContractStatus)status;
                                    <option value="@statusValue" data-badge="@GetStatusBadgeColor(statusValue)">
                                        @statusValue
                                    </option>
                                }
                            </select>
                            <small class="text-muted d-block mt-1">
                                <i class="bi bi-info-circle"></i> Draft contracts can be edited later
                            </small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Contract.ServiceLevel" class="form-label fw-semibold mb-2">
                                <i class="bi bi-star text-warning"></i> Service Level <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Contract.ServiceLevel" class="form-select service-select">
                                @foreach (var level in Enum.GetValues(typeof(ServiceLevel)))
                                {
                                    var levelValue = (ServiceLevel)level;
                                    <option value="@levelValue" data-description="@GetServiceLevelDescription(levelValue)">
                                        @levelValue
                                    </option>
                                }
                            </select>
                            <div class="service-description mt-2 p-2 bg-light rounded">
                                <small id="serviceLevelDesc" class="text-muted">
                                    Select a service level to see description
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Contract Notes -->
                    <div class="mb-4">
                        <label asp-for="Contract.Notes" class="form-label fw-semibold mb-2">
                            <i class="bi bi-pencil-square text-secondary"></i> Contract Notes
                        </label>
                        <textarea asp-for="Contract.Notes" class="form-control notes-textarea" rows="3"
                                  placeholder="Add any special terms, conditions, or notes about this contract..."></textarea>
                        <small class="text-muted mt-1 d-block">
                            <i class="bi bi-info-circle"></i> Internal notes only - not visible to clients
                        </small>
                    </div>

                    <!-- PDF Upload Section -->
                    <div class="mb-4">
                        <label asp-for="SignedAgreement" class="form-label fw-semibold mb-2">
                            <i class="bi bi-file-earmark-pdf text-danger"></i> Signed Agreement
                        </label>
                        <div class="upload-area" id="uploadArea">
                            <input asp-for="SignedAgreement" type="file" class="file-input" accept=".pdf" id="fileInput" />
                            <div class="upload-content">
                                <i class="bi bi-cloud-upload fs-1"></i>
                                <p class="mb-1">Drag & drop or click to upload</p>
                                <small class="text-muted">PDF files only, max 10 MB</small>
                            </div>
                            <div class="file-info" style="display: none;">
                                <i class="bi bi-file-earmark-pdf"></i>
                                <span class="file-name"></span>
                                <button type="button" class="btn btn-sm btn-link remove-file">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </div>
                        </div>
                        <span asp-validation-for="SignedAgreement" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex gap-3 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-gradient-primary rounded-pill px-5 py-2" id="submitBtn">
                            <i class="bi bi-check-lg"></i> Create Contract
                        </button>
                        <button type="reset" class="btn btn-outline-secondary rounded-pill px-4 py-2" onclick="resetForm()">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </button>
                        <a asp-action="Index" class="btn btn-link text-secondary ms-auto">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column - Information & Tips -->
    <div class="col-lg-4">
        <!-- Contract Preview Card -->
        <div class="card-modern mb-4">
            <div class="card-header bg-transparent border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-eye text-primary"></i> Contract Preview
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="preview-item">
                    <small class="text-muted">Client</small>
                    <p class="fw-semibold preview-client">Not selected</p>
                </div>
                <div class="preview-item">
                    <small class="text-muted">Service Level</small>
                    <p class="fw-semibold preview-service">Not selected</p>
                </div>
                <div class="preview-item">
                    <small class="text-muted">Duration</small>
                    <p class="fw-semibold preview-duration">Not set</p>
                </div>
                <div class="preview-item">
                    <small class="text-muted">Status</small>
                    <span class="badge preview-status-badge bg-secondary">Draft</span>
                </div>
            </div>
        </div>

        <!-- Quick Tips Card -->
        <div class="card-modern mb-4">
            <div class="card-header bg-transparent border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-lightbulb text-warning"></i> Quick Tips
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="tip-item mb-3">
                    <i class="bi bi-calendar-check text-success me-2"></i>
                    <small>Ensure end date is after start date</small>
                </div>
                <div class="tip-item mb-3">
                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                    <small>Upload the signed PDF agreement for record keeping</small>
                </div>
                <div class="tip-item mb-3">
                    <i class="bi bi-star text-warning me-2"></i>
                    <small>Higher service levels include faster response times</small>
                </div>
                <div class="tip-item">
                    <i class="bi bi-pencil-square text-info me-2"></i>
                    <small>Draft contracts can be saved and edited later</small>
                </div>
            </div>
        </div>

        <!-- Service Level Comparison -->
        <div class="card-modern">
            <div class="card-header bg-transparent border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-table"></i> Service Level Comparison
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-3">Level</th>
                                <th>Response Time</th>
                                <th>Support Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-3 fw-semibold">Basic</td>
                                <td>48 hours</td>
                                <td>Business hours</td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-semibold">Standard</td>
                                <td>24 hours</td>
                                <td>Business hours</td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-semibold">Premium</td>
                                <td>4 hours</td>
                                <td>24/7</td>
                            </tr>
                            <tr>
                                <td class="ps-3 fw-semibold">Enterprise</td>
                                <td>1 hour</td>
                                <td>24/7 dedicated</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeColor(ContractStatus status)
    {
        return status switch
        {
            ContractStatus.Active => "success",
            ContractStatus.Draft => "secondary",
            ContractStatus.Expired => "danger",
            ContractStatus.OnHold => "warning",
            _ => "secondary"
        };
    }

    string GetServiceLevelDescription(ServiceLevel level)
    {
        return level switch
        {
            ServiceLevel.Basic => "📧 Email support, 48-hour response time, business hours only",
            ServiceLevel.Standard => "📞 Phone + email support, 24-hour response time, business hours",
            ServiceLevel.Premium => "🚀 Priority support, 4-hour response time, 24/7 coverage",
            ServiceLevel.Enterprise => "👑 Dedicated account manager, 1-hour response time, 24/7 priority",
            _ => "Standard service level agreement"
        };
    }
}

<!-- Custom CSS -->
<style>
    .card-modern {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

        .card-modern:hover {
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
        }

    .avatar-lg {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .input-group-text {
        background: transparent;
        color: #4facfe;
        transition: all 0.3s ease;
    }

    .form-control, .form-select {
        border: 1px solid #e0e0e0;
        padding: 0.6rem 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #4facfe;
            box-shadow: 0 0 0 0.2rem rgba(79, 172, 254, 0.25);
        }

    .upload-area {
        border: 2px dashed #dee2e6;
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background: #f8f9fa;
        position: relative;
    }

        .upload-area:hover {
            border-color: #4facfe;
            background: #f0f8ff;
        }

        .upload-area.drag-over {
            border-color: #4facfe;
            background: #e8f4ff;
        }

    .file-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .upload-content i {
        color: #4facfe;
        margin-bottom: 0.5rem;
    }

    .file-info {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.5rem;
        background: #e8f4ff;
        border-radius: 10px;
    }

    .remove-file {
        color: #dc3545;
    }

    .btn-gradient-primary {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        border: none;
        color: white;
        transition: all 0.3s ease;
        font-weight: 600;
    }

        .btn-gradient-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(79, 172, 254, 0.3);
            color: white;
        }

    .alert-modern {
        border: none;
        border-radius: 15px;
        padding: 1rem;
        animation: slideDown 0.5s ease-out;
    }

    @@keyframes slideDown {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .preview-item {
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #e9ecef;
    }

        .preview-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

    .tip-item {
        padding: 0.5rem 0;
        border-bottom: 1px solid #f0f0f0;
    }

        .tip-item:last-child {
            border-bottom: none;
        }

    .notes-textarea {
        resize: vertical;
        min-height: 80px;
    }

    .service-description {
        font-size: 0.85rem;
        border-left: 3px solid #4facfe;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .btn-gradient-primary

    {
        width: 100%;
    }

    .card-body {
        padding: 1.25rem;
    }

    .d-flex.gap-3 {
        flex-direction: column;
    }

    .ms-auto {
        margin-left: 0 !important;
        text-align: center;
    }

    .upload-area {
        padding: 1rem;
    }

    }</style>

<!-- JavaScript -->
<script>
    // Live preview updates
    const clientSelect = document.querySelector('.client-select');
    const serviceSelect = document.querySelector('.service-select');
    const startDateInput = document.querySelector('input[name="Contract.StartDate"]');
    const endDateInput = document.querySelector('input[name="Contract.EndDate"]');
    const statusSelect = document.querySelector('.status-select');

    const previewClient = document.querySelector('.preview-client');
    const previewService = document.querySelector('.preview-service');
    const previewDuration = document.querySelector('.preview-duration');
    const previewStatusBadge = document.querySelector('.preview-status-badge');

    function updatePreview() {
        // Update client
        const selectedClient = clientSelect.options[clientSelect.selectedIndex]?.text;
        previewClient.textContent = selectedClient !== '-- Select a client --' ? selectedClient : 'Not selected';

        // Update service level
        const selectedService = serviceSelect.options[serviceSelect.selectedIndex]?.text;
        previewService.textContent = selectedService || 'Not selected';

        // Update duration
        if (startDateInput.value && endDateInput.value) {
            const start = new Date(startDateInput.value);
            const end = new Date(endDateInput.value);
            const diffTime = Math.abs(end - start);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            previewDuration.textContent = `${diffDays} days (${start.toLocaleDateString()} - ${end.toLocaleDateString()})`;
        } else {
            previewDuration.textContent = 'Not set';
        }

        // Update status badge
        const selectedStatus = statusSelect.options[statusSelect.selectedIndex]?.text;
        const statusColor = statusSelect.options[statusSelect.selectedIndex]?.dataset.badge;
        previewStatusBadge.textContent = selectedStatus;
        previewStatusBadge.className = `badge preview-status-badge bg-${statusColor}`;
    }

    clientSelect?.addEventListener('change', updatePreview);
    serviceSelect?.addEventListener('change', updatePreview);
    startDateInput?.addEventListener('change', updatePreview);
    endDateInput?.addEventListener('change', updatePreview);
    statusSelect?.addEventListener('change', updatePreview);

    // Service level description update
    const serviceLevelDesc = document.getElementById('serviceLevelDesc');
    serviceSelect?.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const description = selectedOption?.dataset.description;
        if (description) {
            serviceLevelDesc.innerHTML = description;
        }
    });

    // Date validation
    function validateDates() {
        if (startDateInput.value && endDateInput.value) {
            const start = new Date(startDateInput.value);
            const end = new Date(endDateInput.value);
            if (end < start) {
                endDateInput.setCustomValidity('End date must be after start date');
                endDateInput.reportValidity();
            } else {
                endDateInput.setCustomValidity('');
            }
        }
    }

    startDateInput?.addEventListener('change', validateDates);
    endDateInput?.addEventListener('change', validateDates);

    // File upload handling
    const uploadArea = document.getElementById('uploadArea');
    const fileInput = document.getElementById('fileInput');
    const uploadContent = document.querySelector('.upload-content');
    const fileInfo = document.querySelector('.file-info');
    const fileName = document.querySelector('.file-name');
    const removeFileBtn = document.querySelector('.remove-file');

    uploadArea?.addEventListener('click', () => fileInput.click());

    fileInput?.addEventListener('change', function(e) {
        if (this.files.length > 0) {
            const file = this.files[0];
            if (file.type === 'application/pdf' && file.size <= 10 * 1024 * 1024) {
                uploadContent.style.display = 'none';
                fileInfo.style.display = 'flex';
                fileName.textContent = file.name;
            } else {
                alert('Please upload a PDF file smaller than 10MB');
                this.value = '';
            }
        }
    });

    removeFileBtn?.addEventListener('click', function(e) {
        e.stopPropagation();
        fileInput.value = '';
        uploadContent.style.display = 'block';
        fileInfo.style.display = 'none';
    });

    // Drag and drop
    uploadArea?.addEventListener('dragover', (e) => {
        e.preventDefault();
        uploadArea.classList.add('drag-over');
    });

    uploadArea?.addEventListener('dragleave', () => {
        uploadArea.classList.remove('drag-over');
    });

    uploadArea?.addEventListener('drop', (e) => {
        e.preventDefault();
        uploadArea.classList.remove('drag-over');
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            fileInput.files = files;
            const event = new Event('change');
            fileInput.dispatchEvent(event);
        }
    });

    // Reset form
    function resetForm() {
        if (confirm('Are you sure you want to reset all form fields?')) {
            document.getElementById('contractForm').reset();
            uploadContent.style.display = 'block';
            fileInfo.style.display = 'none';
            updatePreview();
        }
    }

    // Loading state on submit
    const form = document.getElementById('contractForm');
    const submitBtn = document.getElementById('submitBtn');

    form?.addEventListener('submit', function(e) {
        if (form.checkValidity()) {
            submitBtn.classList.add('loading');
            submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Creating Contract...';
            submitBtn.disabled = true;
        }
    });

    // Initial preview
    updatePreview();
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}