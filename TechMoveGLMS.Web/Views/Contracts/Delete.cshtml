@model Contract
@{
    ViewData["Title"] = "Delete Contract";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-danger"><i class="bi bi-trash"></i> Delete Contract #@Model.Id</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>
<div class="card-modern p-4 text-center">
    <i class="bi bi-exclamation-triangle-fill text-danger display-1"></i>
    <h3 class="mt-3">Delete this contract?</h3>
    <p class="text-muted">This will also delete all @Model.ServiceRequests.Count service request(s).</p>
    <dl class="row justify-content-center"><dt class="col-sm-3">Client</dt><dd class="col-sm-9">@Model.Client?.Name</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd></dl>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger rounded-pill px-4"><i class="bi bi-trash"></i> Yes, Delete</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
    </form>
</div>