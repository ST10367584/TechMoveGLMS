@model Contract
@{ ViewData["Title"] = "Delete Contract"; }

<h2 class="text-danger"><i class="bi bi-trash"></i> Delete Contract #@Model.Id</h2>
<p class="text-muted">Are you sure? This will delete the contract and all its service requests.</p>
<hr />

<dl class="row">
    <dt class="col-sm-3">Client</dt><dd class="col-sm-9">@Model.Client?.Name</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Service Level</dt><dd class="col-sm-9">@Model.ServiceLevel</dd>
    <dt class="col-sm-3">Start Date</dt><dd class="col-sm-9">@Model.StartDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">End Date</dt><dd class="col-sm-9">@Model.EndDate.ToString("dd MMM yyyy")</dd>
</dl>

<form asp-action="Delete" method="post">
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
