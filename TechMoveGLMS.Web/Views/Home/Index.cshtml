@model List<Contract>
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-5 fw-bold mb-1">
            <i class="bi bi-speedometer2 text-primary"></i> Dashboard
        </h1>
        <p class="text-muted">Welcome back. Your logistics operations at a glance.</p>
    </div>
    <div class="d-none d-md-block">
        <div class="dropdown">
            <button class="btn btn-glass dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-calendar-week"></i> This Month
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#">Today</a></li>
                <li><a class="dropdown-item" href="#">This Week</a></li>
                <li><a class="dropdown-item" href="#">This Month</a></li>
                <li><a class="dropdown-item" href="#">This Year</a></li>
            </ul>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-value">@ViewBag.TotalClients</div>
            <div class="stat-label">Total Clients</div>
            <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
            <div class="mt-2">
                <small class="text-muted"><i class="bi bi-arrow-up-short text-success"></i> +12% vs last month</small>
            </div>
            <a asp-controller="Clients" asp-action="Index" class="stretched-link"></a>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-value">@ViewBag.ActiveContracts</div>
            <div class="stat-label">Active Contracts</div>
            <div class="stat-icon"><i class="bi bi-file-earmark-check-fill"></i></div>
            <div class="mt-2">
                <small class="text-muted"><i class="bi bi-check-circle"></i> @ViewBag.TotalContracts Total</small>
            </div>
            <a asp-controller="Contracts" asp-action="Index" asp-route-statusFilter="Active" class="stretched-link"></a>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-value">@ViewBag.TotalContracts</div>
            <div class="stat-label">Total Contracts</div>
            <div class="stat-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
            <div class="mt-2">
                <small class="text-muted"><i class="bi bi-calendar"></i> Lifetime value</small>
            </div>
            <a asp-controller="Contracts" asp-action="Index" class="stretched-link"></a>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-value">@ViewBag.PendingRequests</div>
            <div class="stat-label">Pending Requests</div>
            <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
            <div class="mt-2">
                <small class="text-muted"><i class="bi bi-exclamation-triangle"></i> Needs attention</small>
            </div>
            <a asp-controller="ServiceRequests" asp-action="Index" class="stretched-link"></a>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row g-4 mb-5">
    <div class="col-lg-8">
        <div class="card-modern">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-text me-2 text-primary"></i> Recent Contracts</h5>
                    <small class="text-muted">Latest 5 contracts added</small>
                </div>
                <a asp-controller="Contracts" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-plus-circle"></i> New Contract
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Client</th>
                                <th>Service Level</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-2"><i class="bi bi-person text-primary"></i></div>
                                            <strong>@c.Client?.Name</strong>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-secondary bg-opacity-10 text-light">@c.ServiceLevel</span></td>
                                    <td>@c.StartDate.ToString("dd MMM yyyy")</td>
                                    <td>@c.EndDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @{
                                            var (badgeClass, icon) = c.Status switch
                                            {
                                                ContractStatus.Active => ("success", "check-circle"),
                                                ContractStatus.Draft => ("secondary", "file-earmark"),
                                                ContractStatus.Expired => ("danger", "x-circle"),
                                                ContractStatus.OnHold => ("warning", "pause-circle"),
                                                _ => ("secondary", "circle")
                                            };
                                        }
                                        <span class="badge bg-@badgeClass bg-opacity-10 text-@badgeClass rounded-pill px-3 py-2">
                                            <i class="bi bi-@icon me-1"></i> @c.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-controller="Contracts" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-eye"></i> View</a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <i class="bi bi-inbox fs-1 text-muted"></i>
                                        <p class="mt-2">No contracts yet. <a asp-controller="Contracts" asp-action="Create">Create one</a></p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (Model.Any())
            {
                <div class="card-footer text-center">
                    <a asp-controller="Contracts" asp-action="Index" class="text-decoration-none">View All Contracts <i class="bi bi-arrow-right"></i></a>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="card-modern mb-4">
            <div class="card-header"><h5 class="fw-bold mb-0"><i class="bi bi-lightning-charge me-2 text-secondary"></i> Quick Actions</h5></div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="Clients" asp-action="Create" class="btn btn-outline-primary text-start px-3"><i class="bi bi-person-plus"></i> Add New Client</a>
                    <a asp-controller="Contracts" asp-action="Create" class="btn btn-outline-success text-start px-3"><i class="bi bi-file-earmark-plus"></i> Create Contract</a>
                    <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-outline-warning text-start px-3"><i class="bi bi-plus-circle"></i> New Service Request</a>
                </div>
            </div>
        </div>

        <!-- Upcoming Expirations -->
        <div class="card-modern mb-4">
            <div class="card-header"><h5 class="fw-bold mb-0"><i class="bi bi-calendar-exclamation me-2 text-danger"></i> Upcoming Expirations</h5></div>
            <div class="card-body">
                @{
                    var expiring = Model.Where(c => c.EndDate <= DateTime.Now.AddDays(30) && c.Status == ContractStatus.Active).Take(3);
                }
                @foreach (var contract in expiring)
                {
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary">
                        <div><strong>@contract.Client?.Name</strong><div><small class="text-muted">Expires in @((contract.EndDate - DateTime.Now).Days) days</small></div></div>
                        <span class="badge bg-warning bg-opacity-10 text-warning">@contract.EndDate.ToString("dd MMM")</span>
                    </div>
                }
                @if (!expiring.Any())
                {
                    <div class="text-center py-3"><i class="bi bi-calendar-check fs-1 text-muted"></i><p class="mt-2">No contracts expiring soon</p></div>
                }
            </div>
        </div>

        <!-- System Health -->
        <div class="card-modern">
            <div class="card-header"><h5 class="fw-bold mb-0"><i class="bi bi-heart-pulse me-2 text-info"></i> System Health</h5></div>
            <div class="card-body">
                <div class="mb-3"><div class="d-flex justify-content-between"><small>Storage</small><small>64%</small></div><div class="progress"><div class="progress-bar" style="width:64%"></div></div></div>
                <div class="mb-3"><div class="d-flex justify-content-between"><small>API Response</small><small>124ms</small></div><div class="progress"><div class="progress-bar bg-success" style="width:32%"></div></div></div>
                <div><div class="d-flex justify-content-between"><small>Active Sessions</small><small>3</small></div><div class="progress"><div class="progress-bar bg-info" style="width:15%"></div></div></div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-sm {
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(16,185,129,0.2);
        border-radius: 0.5rem;
    }
</style>