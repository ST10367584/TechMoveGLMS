@model Client
@{
    ViewData["Title"] = "Delete Client";
    var hasContracts = Model.Contracts.Any();
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="display-5 fw-bold text-danger"><i class="bi bi-trash-fill"></i> Delete Client</h1></div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="card-modern p-4 text-center">
    @if (hasContracts)
    {
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle-fill"></i> Cannot delete client with @Model.Contracts.Count contract(s). Delete or reassign contracts first.</div>
        <a asp-controller="Contracts" asp-action="Index" asp-route-clientFilter="@Model.Id" class="btn btn-warning">View Contracts</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit Client</a>
    }
    else
    {
        <i class="bi bi-exclamation-triangle-fill text-danger display-1"></i>
        <h3 class="mt-3">Delete @Model.Name?</h3>
        <p class="text-muted">This action cannot be undone.</p>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger rounded-pill px-4"><i class="bi bi-trash"></i> Permanently Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
        </form>
    }
</div>