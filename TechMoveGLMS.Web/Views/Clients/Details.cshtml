@model Client
@{
    ViewData["Title"] = Model.Name;
}
<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div class="d-flex align-items-center gap-3">
        <div class="client-avatar-large" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"><span class="avatar-initials">@(string.Join("", Model.Name.Split(' ').Select(n => n[0]).Take(2)).ToUpper())</span></div>
        <div><h1 class="display-5 fw-bold" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">@Model.Name</h1><div class="d-flex gap-2"><span class="badge bg-light text-dark"><i class="bi bi-geo-alt"></i> @(Model.Region ?? "No region")</span><span class="badge bg-primary bg-opacity-10 text-primary"><i class="bi bi-calendar"></i> Since @Model.CreatedAt.ToString("MMM yyyy")</span></div></div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-controller="Contracts" asp-action="Create" asp-route-clientId="@Model.Id" class="btn btn-success rounded-pill"><i class="bi bi-plus-circle"></i> New Contract</a>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card-modern p-4 mb-4"><h5><i class="bi bi-info-circle"></i> Contact Information</h5><hr /><div class="mb-2"><small>Contact Person</small><div class="fw-bold">@(Model.ContactPerson ?? "—")</div></div><div class="mb-2"><small>Email</small><div><a href="mailto:@Model.Email">@Model.Email</a></div></div><div class="mb-2"><small>Phone</small><div>@(Model.Phone ?? "—")</div></div><div><small>Address</small><div>@(Model.Address ?? "—")</div></div></div>
    </div>
    <div class="col-lg-8">
        <div class="card-modern">
            <div class="card-header bg-transparent"><h5><i class="bi bi-file-earmark-text"></i> Contracts (@Model.Contracts.Count)</h5></div><div class="list-group list-group-flush">
                @foreach (var contract in Model.Contracts.OrderByDescending(c => c.CreatedAt))
                {
                    <div class="list-group-item"><div class="d-flex justify-content-between"><div><strong>Contract #@contract.Id</strong><br /><small>@contract.ServiceLevel · @contract.Status</small></div><div><a asp-controller="Contracts" asp-action="Details" asp-route-id="@contract.Id" class="btn btn-sm btn-outline-primary">View</a></div></div><div class="mt-2 small text-muted">@contract.StartDate.ToString("dd MMM yyyy") - @contract.EndDate.ToString("dd MMM yyyy")</div></div>
                }
                @if (!Model.Contracts.Any())
                {
                    <div class="list-group-item text-center">No contracts yet. <a asp-controller="Contracts" asp-action="Create" asp-route-clientId="@Model.Id">Create one</a></div>
                }
            </div>
        </div>
    </div>
</div>
<style>
    .client-avatar-large {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .avatar-initials {
        font-size: 1.75rem;
        font-weight: bold;
        color: white;
    }
</style>