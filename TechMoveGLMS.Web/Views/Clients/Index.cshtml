@model List<Client>
@{
    ViewData["Title"] = "Clients";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-5 fw-bold mb-1" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">
            <i class="bi bi-people-fill"></i> Clients
        </h1>
        <p class="text-muted">Manage your client relationships and view contract details</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle"></i> Add Client
        </a>
    </div>
</div>

<!-- Stats Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card-modern text-center p-3">
            <div class="fs-2 fw-bold text-primary">@Model.Count</div>
            <div class="text-muted small">Total Clients</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card-modern text-center p-3">
            <div class="fs-2 fw-bold text-success">@Model.Where(c => c.Contracts?.Any() == true).Count()</div>
            <div class="text-muted small">Active Clients</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card-modern text-center p-3">
            <div class="fs-2 fw-bold text-info">@Model.Sum(c => c.Contracts?.Count ?? 0)</div>
            <div class="text-muted small">Total Contracts</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card-modern text-center p-3">
            <div class="fs-2 fw-bold text-warning">@Model.Select(c => c.Region).Distinct().Count()</div>
            <div class="text-muted small">Regions Served</div>
        </div>
    </div>
</div>

<!-- Enhanced Search Bar -->
<div class="card-modern mb-4">
    <div class="card-body p-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-semibold mb-2">
                    <i class="bi bi-search"></i> Search Clients
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0">
                        <i class="bi bi-person"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search"
                           class="form-control border-start-0 ps-0"
                           placeholder="Search by name, region, email or contact person..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold mb-2">
                    <i class="bi bi-funnel"></i> Filter by Region
                </label>
                <select name="region" class="form-select" onchange="this.form.submit()">
                    <option value="">All Regions</option>
                    @{
                        var regions = Model.Select(c => c.Region).Distinct().Where(r => !string.IsNullOrEmpty(r));
                    }
                    @foreach (var region in regions)
                    {
                        <option value="@region" selected="@(ViewBag.RegionFilter == region)">
                            @region
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <div class="d-flex gap-2">
                    <button class="btn btn-primary rounded-pill px-4 flex-grow-1">
                        <i class="bi bi-search"></i> Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-x-circle"></i> Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Client Cards Grid (Modern Card Layout) -->
<div class="row g-4">
    @foreach (var client in Model)
    {
        <div class="col-xl-4 col-lg-6 col-md-6">
            <div class="client-card">
                <!-- Card Header with Gradient Background -->
                <div class="client-card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="client-avatar">
                            <span class="avatar-initials">
                                @(string.Join("", client.Name.Split(' ').Select(n => n[0]).Take(2)).ToUpper())
                            </span>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a asp-action="Details" asp-route-id="@client.Id" class="dropdown-item">
                                        <i class="bi bi-eye"></i> View Details
                                    </a>
                                </li>
                                <li>
                                    <a asp-action="Edit" asp-route-id="@client.Id" class="dropdown-item">
                                        <i class="bi bi-pencil"></i> Edit Client
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a asp-action="Delete" asp-route-id="@client.Id" class="dropdown-item text-danger">
                                        <i class="bi bi-trash"></i> Delete Client
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="client-card-body">
                    <h5 class="client-name mb-1">@client.Name</h5>
                    <p class="text-muted small mb-3">
                        <i class="bi bi-geo-alt"></i> @(client.Region ?? "No region specified")
                    </p>

                    <!-- Contact Information -->
                    <div class="contact-info mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <div class="contact-icon">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div class="ms-2">
                                <small class="text-muted d-block">Contact Person</small>
                                <span class="fw-semibold">@(client.ContactPerson ?? "Not specified")</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <div class="contact-icon">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div class="ms-2">
                                <small class="text-muted d-block">Email Address</small>
                                <span class="fw-semibold">@client.Email</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(client.Phone))
                        {
                            <div class="d-flex align-items-center">
                                <div class="contact-icon">
                                    <i class="bi bi-telephone"></i>
                                </div>
                                <div class="ms-2">
                                    <small class="text-muted d-block">Phone Number</small>
                                    <span class="fw-semibold">@client.Phone</span>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Contract Stats -->
                    <div class="contract-stats">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-muted">
                                <i class="bi bi-file-earmark-text"></i> Contracts
                            </small>
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1">
                                @(client.Contracts?.Count ?? 0) Total
                            </span>
                        </div>
                        @if (client.Contracts?.Any() == true)
                        {
                            var activeContracts = client.Contracts.Count(c => c.Status == ContractStatus.Active);
                            if (activeContracts > 0)
                            {
                                <div class="progress mb-2" style="height: 6px;">
                                    <div class="progress-bar bg-success" style="width: @((double)activeContracts / client.Contracts.Count * 100)%"></div>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <small class="text-success">
                                        <i class="bi bi-check-circle"></i> @activeContracts Active
                                    </small>
                                    <small class="text-muted">
                                        @(client.Contracts.Count - activeContracts) Inactive
                                    </small>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light text-center py-2 mb-0 mt-2">
                                    <small class="text-muted">No active contracts</small>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-light text-center py-2 mb-0 mt-2">
                                <small class="text-muted">No contracts yet</small>
                            </div>
                        }
                    </div>
                </div>

                <!-- Card Footer with Quick Actions -->
                <div class="client-card-footer">
                    <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-outline-primary rounded-pill">
                        <i class="bi bi-eye"></i> View Details
                    </a>
                    <a asp-controller="Contracts" asp-action="Create" asp-route-clientId="@client.Id"
                       class="btn btn-primary rounded-pill">
                        <i class="bi bi-plus-circle"></i> New Contract
                    </a>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="empty-state">
                <i class="bi bi-people fs-1 text-muted"></i>
                <h4 class="mt-3">No Clients Found</h4>
                <p class="text-muted">Get started by adding your first client to the system.</p>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 mt-2">
                    <i class="bi bi-plus-circle"></i> Add Your First Client
                </a>
            </div>
        </div>
    }
</div>

<!-- Custom CSS for Client Cards -->
<style>
    .card-modern {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

        .card-modern:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
        }

    .client-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .client-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
        }

    .client-card-header {
        padding: 1.5rem;
        position: relative;
    }

    .client-avatar {
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px);
    }

    .avatar-initials {
        color: white;
        font-weight: bold;
        font-size: 1.25rem;
    }

    .client-card-body {
        padding: 1.5rem;
        flex: 1;
    }

    .client-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .contact-icon {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #667eea;
    }

    .contract-stats {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 15px;
        margin-top: 1rem;
    }

    .client-card-footer {
        padding: 1rem 1.5rem 1.5rem;
        display: flex;
        gap: 0.75rem;
        border-top: 1px solid #e9ecef;
    }

        .client-card-footer .btn {
            flex: 1;
            font-size: 0.875rem;
        }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .client-card-footer

    {
        flex-direction: column;
    }

    .client-card-footer .btn {
        width: 100%;
    }

    .empty-state {
        padding: 2rem 1rem;
    }

    }

    /* Search input styling */
    .input-group-text {
        background: transparent;
        color: #667eea;
    }

    .form-control:focus, .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }
</style>