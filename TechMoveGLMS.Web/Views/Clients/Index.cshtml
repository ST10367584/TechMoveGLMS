@model List<Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-5 fw-bold" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; background-clip: text; color: transparent;">
            <i class="bi bi-people-fill"></i> Clients
        </h1>
        <p class="text-muted">Manage your client relationships and contracts</p>
    </div>
    <a asp-action="Create" class="btn btn-gradient rounded-pill px-4"><i class="bi bi-plus-circle"></i> Add Client</a>
</div>

<!-- Stats Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6"><div class="card-modern text-center p-3"><div class="fs-2 fw-bold text-primary">@Model.Count</div><div class="text-muted">Total Clients</div></div></div>
    <div class="col-md-3 col-6"><div class="card-modern text-center p-3"><div class="fs-2 fw-bold text-success">@Model.Where(c => c.Contracts?.Any() == true).Count()</div><div class="text-muted">Active Clients</div></div></div>
    <div class="col-md-3 col-6"><div class="card-modern text-center p-3"><div class="fs-2 fw-bold text-info">@Model.Sum(c => c.Contracts?.Count ?? 0)</div><div class="text-muted">Total Contracts</div></div></div>
    <div class="col-md-3 col-6"><div class="card-modern text-center p-3"><div class="fs-2 fw-bold text-warning">@Model.Select(c => c.Region).Distinct().Count()</div><div class="text-muted">Regions</div></div></div>
</div>

<!-- Search Bar -->
<div class="card-modern mb-4 p-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label fw-semibold"><i class="bi bi-search"></i> Search</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Name, region, email, contact person..." />
        </div>
        <div class="col-md-4">
            <button class="btn btn-gradient w-100"><i class="bi bi-search"></i> Search</button>
        </div>
    </form>
</div>

<!-- Client Cards Grid -->
<div class="row g-4">
    @foreach (var client in Model)
    {
        <div class="col-xl-4 col-lg-6 col-md-6">
            <div class="client-card">
                <div class="client-card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="client-avatar"><span class="avatar-initials">@(string.Join("", client.Name.Split(' ').Select(n => n[0]).Take(2)).ToUpper())</span></div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a asp-action="Details" asp-route-id="@client.Id" class="dropdown-item"><i class="bi bi-eye"></i> Details</a></li>
                                <li><a asp-action="Edit" asp-route-id="@client.Id" class="dropdown-item"><i class="bi bi-pencil"></i> Edit</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a asp-action="Delete" asp-route-id="@client.Id" class="dropdown-item text-danger"><i class="bi bi-trash"></i> Delete</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="client-card-body">
                    <h5 class="client-name">@client.Name</h5>
                    <p class="text-muted small"><i class="bi bi-geo-alt"></i> @(client.Region ?? "No region")</p>
                    <div class="contact-info mb-3">
                        <div class="d-flex align-items-center mb-2"><div class="contact-icon"><i class="bi bi-person-badge"></i></div><div class="ms-2"><small class="text-muted">Contact</small><div class="fw-semibold">@(client.ContactPerson ?? "—")</div></div></div>
                        <div class="d-flex align-items-center"><div class="contact-icon"><i class="bi bi-envelope"></i></div><div class="ms-2"><small class="text-muted">Email</small><div class="fw-semibold">@client.Email</div></div></div>
                    </div>
                    <div class="contract-stats">
                        <div class="d-flex justify-content-between"><small><i class="bi bi-file-earmark-text"></i> Contracts</small><span class="badge bg-primary bg-opacity-10 text-primary">@(client.Contracts?.Count ?? 0) total</span></div>
                        @{
                            var active = client.Contracts?.Count(c => c.Status == ContractStatus.Active) ?? 0;
                            var total = client.Contracts?.Count ?? 0;
                            var percent = total > 0 ? (double)active / total * 100 : 0;
                        }
                        <div class="progress mt-2" style="height: 6px;"><div class="progress-bar bg-success" style="width: @percent%"></div></div>
                        <div class="d-flex justify-content-between mt-1"><small class="text-success">@active active</small><small class="text-muted">@(total - active) inactive</small></div>
                    </div>
                </div>
                <div class="client-card-footer">
                    <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-outline-primary rounded-pill"><i class="bi bi-eye"></i> View</a>
                    <a asp-controller="Contracts" asp-action="Create" asp-route-clientId="@client.Id" class="btn btn-primary rounded-pill"><i class="bi bi-plus-circle"></i> Contract</a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5"><i class="bi bi-people fs-1 text-muted"></i><h4 class="mt-3">No clients yet</h4><a asp-action="Create" class="btn btn-gradient mt-2">Add your first client</a></div>
    }
</div>

<style>
    .client-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .client-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.12);
        }

    .client-card-header {
        padding: 1.5rem;
    }

    .client-avatar {
        width: 60px;
        height: 60px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px);
    }

    .avatar-initials {
        color: white;
        font-weight: bold;
        font-size: 1.25rem;
    }

    .client-card-body {
        padding: 1.5rem;
        flex: 1;
    }

    .client-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .contact-icon {
        width: 32px;
        height: 32px;
        background: rgba(102,126,234,0.1);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #667eea;
    }

    .contract-stats {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 15px;
        margin-top: 1rem;
    }

    .client-card-footer {
        padding: 1rem 1.5rem 1.5rem;
        display: flex;
        gap: 0.75rem;
        border-top: 1px solid #e9ecef;
    }

        .client-card-footer .btn {
            flex: 1;
        }

    @@media (max-width: 768px) {
        .client-card-footer {
            flex-direction: column;
        }
    }
</style>