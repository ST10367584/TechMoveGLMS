@model ServiceRequest
@{
    ViewData["Title"] = $"Edit Service Request #{Model.Id}";
}

<h2><i class="bi bi-pencil-square text-warning"></i> Edit Service Request #@Model.Id</h2>
<hr />

<div class="row">
    <div class="col-md-7">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ContractId" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="ExchangeRateUsed" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CostUSD" class="form-label fw-semibold">Cost (USD $)</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="CostUSD" class="form-control" type="number" step="0.01" />
                </div>
                <div class="form-text text-muted">
                    Changing the USD amount will recalculate ZAR at the current rate.
                </div>
                <span asp-validation-for="CostUSD" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Current ZAR (R)</label>
                <div class="input-group">
                    <span class="input-group-text">R</span>
                    <input value="@Model.CostZAR.ToString("N2")" class="form-control" readonly />
                </div>
                <small class="text-muted">Rate saved: @Model.ExchangeRateUsed.ToString("N4")</small>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label fw-semibold"></label>
                <select asp-for="Status" class="form-select"
                        asp-items="Html.GetEnumSelectList<ServiceRequestStatus>()"></select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-floppy"></i> Update Request
                </button>
                <a asp-controller="Contracts" asp-action="Details" asp-route-id="@Model.ContractId"
                   class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
