@model ServiceRequestCreateViewModel
@{
    ViewData["Title"] = "New Service Request";
}
<div class="card-modern p-4">
    <h2><i class="bi bi-plus-circle text-success"></i> New Service Request</h2>
    <p class="text-muted">@Model.ContractInfo</p>
    <hr />
    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="ContractId" />
        <input type="hidden" id="exchangeRate" name="ExchangeRate" value="@Model.ExchangeRate" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="card bg-light p-3 mb-3">
            <div class="d-flex justify-content-between">
                <strong><i class="bi bi-currency-exchange"></i> Currency Conversion</strong>
                <span class="badge bg-info" id="rateDisplay">Loading rate...</span>
            </div>
            <div class="row mt-2">
                <div class="col-md-6">
                    <label asp-for="CostUSD" class="form-label">Amount (USD $)</label>
                    <input asp-for="CostUSD" class="form-control" id="costUSD" step="0.01" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">ZAR (R)</label>
                    <input type="text" id="costZAR" class="form-control bg-white" readonly />
                    <input type="hidden" asp-for="CostZAR" id="hiddenCostZAR" />
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ServiceRequestStatus>()"></select>
        </div>

        <button type="submit" class="btn btn-gradient"><i class="bi bi-floppy"></i> Submit Request</button>
        <a asp-controller="Contracts" asp-action="Details" asp-route-id="@Model.ContractId" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let rate = @Model.ExchangeRate;
        async function fetchRate() {
            try {
                const resp = await fetch('/ServiceRequests/GetRate');
                const data = await resp.json();
                rate = data.rate;
                document.getElementById('rateDisplay').innerText = `1 USD = R ${rate.toFixed(4)}`;
                document.getElementById('exchangeRate').value = rate;
                recalc();
            } catch(e) { document.getElementById('rateDisplay').innerText = `Rate: R ${rate.toFixed(4)} (cached)`; }
        }
        function recalc() {
            let usd = parseFloat(document.getElementById('costUSD').value) || 0;
            let zar = (usd * rate).toFixed(2);
            document.getElementById('costZAR').value = zar;
            document.getElementById('hiddenCostZAR').value = zar;
        }
        document.getElementById('costUSD').addEventListener('input', recalc);
        fetchRate();
    </script>
}