@model ServiceRequestCreateViewModel
@{
    ViewData["Title"] = "New Service Request";
}

<h2><i class="bi bi-plus-circle text-success"></i> New Service Request</h2>
<p class="text-muted">@Model.ContractInfo</p>
<hr />

<div class="row">
    <div class="col-md-7">
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="ContractId" />
            <input type="hidden" id="hiddenExchangeRate" name="ExchangeRate" value="@Model.ExchangeRate" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="4"
                          placeholder="Describe the service being requested..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <!-- Currency Conversion Block -->
            <div class="card bg-light border-0 mb-3 p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong><i class="bi bi-currency-exchange"></i> Currency Conversion</strong>
                    <span class="badge bg-info" id="rateDisplay">
                        Loading rate...
                    </span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CostUSD" class="form-label fw-semibold">Cost (USD $)</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="CostUSD" class="form-control" type="number"
                                   step="0.01" min="0.01" id="costUSD"
                                   placeholder="Enter amount in USD" />
                        </div>
                        <span asp-validation-for="CostUSD" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Auto-calculated ZAR (R)</label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <input type="text" id="costZARDisplay" class="form-control bg-white"
                                   readonly placeholder="Calculated automatically" />
                        </div>
                        <input type="hidden" asp-for="CostZAR" id="hiddenCostZAR" />
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label fw-semibold"></label>
                <select asp-for="Status" class="form-select"
                        asp-items="Html.GetEnumSelectList<ServiceRequestStatus>()"></select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-floppy"></i> Submit Request
                </button>
                <a asp-controller="Contracts" asp-action="Details" asp-route-id="@Model.ContractId"
                   class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header"><strong><i class="bi bi-info-circle"></i> Currency Info</strong></div>
            <div class="card-body small">
                <p>TechMove reports all costs in <strong>South African Rand (ZAR)</strong>.</p>
                <p>Enter the cost in USD and the system automatically fetches the live exchange rate
                   from <a href="https://open.er-api.com" target="_blank">Open Exchange Rates API</a>
                   and converts it for you.</p>
                <p class="mb-0 text-muted">The rate used is saved with every request for audit purposes.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Fetch the live USD→ZAR exchange rate from our controller endpoint
        let exchangeRate = @Model.ExchangeRate;

        async function fetchRate() {
            try {
                const resp = await fetch('/ServiceRequests/GetRate');
                const data = await resp.json();
                exchangeRate = data.rate;
                document.getElementById('rateDisplay').textContent =
                    `1 USD = R ${exchangeRate.toFixed(4)} ZAR`;
                document.getElementById('hiddenExchangeRate').value = exchangeRate;
                recalculate();
            } catch (e) {
                document.getElementById('rateDisplay').textContent =
                    `Rate: R ${exchangeRate.toFixed(4)} (cached)`;
            }
        }

        function recalculate() {
            const usd = parseFloat(document.getElementById('costUSD').value) || 0;
            const zar = (usd * exchangeRate).toFixed(2);
            document.getElementById('costZARDisplay').value = zar > 0 ? `${zar}` : '';
            document.getElementById('hiddenCostZAR').value = zar;
        }

        document.getElementById('costUSD').addEventListener('input', recalculate);
        fetchRate();
    </script>
}
