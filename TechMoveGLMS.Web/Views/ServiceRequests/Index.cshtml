@model List<ServiceRequest>
@{
    ViewData["Title"] = "Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-list-check text-primary"></i> All Service Requests</h2>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Contract</th>
                    <th>Client</th>
                    <th>Description</th>
                    <th>Cost (USD)</th>
                    <th>Cost (ZAR)</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sr in Model)
                {
                    var badge = sr.Status switch
                    {
                        ServiceRequestStatus.Pending => "warning",
                        ServiceRequestStatus.InProgress => "info",
                        ServiceRequestStatus.Completed => "success",
                        ServiceRequestStatus.Cancelled => "danger",
                        _ => "secondary"
                    };
                    <tr>
                        <td>@sr.Id</td>
                        <td>
                            <a asp-controller="Contracts" asp-action="Details" asp-route-id="@sr.ContractId">
                                #@sr.ContractId
                            </a>
                        </td>
                        <td>@sr.Contract?.Client?.Name</td>
                        <td>@sr.Description</td>
                        <td>$@sr.CostUSD.ToString("N2")</td>
                        <td class="text-success fw-semibold">R @sr.CostZAR.ToString("N2")</td>
                        <td><span class="badge bg-@badge">@sr.Status</span></td>
                        <td><small>@sr.CreatedAt.ToString("dd MMM yyyy")</small></td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@sr.Id" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@sr.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No service requests yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
