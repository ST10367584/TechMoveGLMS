<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechMove GLMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div id="loadingSpinner" class="spinner-overlay"><div class="spinner-modern"></div></div>

    <nav class="navbar navbar-expand-lg navbar-modern sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="/"><i class="bi bi-box-seam"></i> TechMove GLMS</a>
            <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Clients" asp-action="Index"><i class="bi bi-people"></i> Clients</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Contracts" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Contracts</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ServiceRequests" asp-action="Index"><i class="bi bi-list-check"></i> Service Requests</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-modern alert-dismissible fade show"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-modern alert-dismissible fade show"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @RenderBody()
    </div>

    <footer class="footer-modern mt-5 py-3 text-center">
        <small>&copy; 2026 TechMove GLMS | ST10369372</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('submit', function(e) { if (e.target.tagName === 'FORM') document.getElementById('loadingSpinner').style.display = 'flex'; });
        window.addEventListener('load', function() { document.getElementById('loadingSpinner').style.display = 'none'; });
        setTimeout(() => document.querySelectorAll('.alert').forEach(a => a.classList.add('fade')), 5000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>